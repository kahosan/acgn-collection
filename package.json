    "framer-motion": "^12.23.26",
    "geist": "^1.5.1",
    "jotai": "^2.16.0",
    "next": "16.0.10",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "rc-rate": "^2.13.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
